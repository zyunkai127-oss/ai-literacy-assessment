# Required for live AI chat. Keep credentials in .env.local.
ANTHROPIC_API_KEY=
# Optional overrides
CHAT_MODEL=claude-haiku-5-5
DB_PATH=./data/app.db
# Independent assessor runs per report, from 1 to 5. A task level counts when two runs agree.
ASSESSOR_RUNS=3

# Separate teacher-review access. Use a strong value on the server.
OPS_REVIEW_KEY=
